# PhishGuard Environment Configuration Template
# Copy this file to .env and configure your local values.

APP_NAME="PhishGuard"
APP_VERSION="2.5.0"
DATABASE_URL="sqlite:///./phishguard.db"

# Generate a unique local key for Fernet token encryption.
ENCRYPTION_SECRET="generate-a-random-secret-at-least-32-characters"

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:5173/gmail-connect"

# Optional Google Cloud Pub/Sub topic for Gmail push notifications.
GOOGLE_PUBSUB_TOPIC=""

# Optional LLM API key.
AI_API_KEY=""

# Required only for the Gmail Workspace add-on.
# Generate a random value of at least 32 characters and configure the same
# value in the add-on project's PHISHGUARD_API_KEY Script Property.
GMAIL_ADDON_API_KEY=""
