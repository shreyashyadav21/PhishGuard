# PhishGuard Environment Configuration Template
# Copy this file to .env and configure your values

# Application Settings
APP_NAME="PhishGuard"
APP_VERSION="2.5.0"
DATABASE_URL="sqlite:///./phishguard.db"

# Master Secret Key for Fernet 256-bit AES Token Encryption
ENCRYPTION_SECRET="generate-a-random-secure-string-here-32bytes"

# Google Cloud Platform (GCP) OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YOUR_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:5173/gmail-connect"

# Google Cloud Pub/Sub Topic for Real-Time Mailbox Notifications
# e.g., projects/your-project-id/topics/gmail-notifications
GOOGLE_PUBSUB_TOPIC=""

# Optional LLM API Key (PhishGuard uses deterministic local heuristic fallback if omitted)
AI_API_KEY=""

